{
  "name": "workspace-map",
  "displayName": "Workspace Map",
  "description": "A navigable filesystem canvas across Windows, WSL and SSH, with shared Agent tools.",
  "version": "0.13.0",
  "publisher": "orion-workspace",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:workspacemap",
    "onFileSystem:workspacemap-win",
    "onWebviewPanel:workspaceMap"
  ],
  "contributes": {
    "commands": [
      {
        "command": "workspaceMap.open",
        "title": "Workspace Map: 打开目录地图",
        "icon": "$(map)"
      },
      {
        "command": "workspaceMap.addEndpoint",
        "title": "Workspace Map: 添加 SSH 连接",
        "icon": "$(add)"
      },
      {
        "command": "workspaceMap.connectCodex",
        "title": "Workspace Map: 接入 Codex",
        "icon": "$(plug)"
      },
      {
        "command": "workspaceMap.connectDsh",
        "title": "Workspace Map: 接入 dsh",
        "icon": "$(plug)"
      },
      {
        "command": "workspaceMap.bindWindow",
        "title": "Workspace Map: 绑定此窗口",
        "icon": "$(plug)"
      },
      {
        "command": "workspaceMap.mcpConfig",
        "title": "Workspace Map: 获取 MCP 配置",
        "icon": "$(settings-gear)"
      },
      {
        "command": "workspaceMap.logs",
        "title": "Workspace Map: 查看诊断日志",
        "icon": "$(output)"
      },
      {
        "command": "workspaceMap.sidebar",
        "title": "Workspace Map: 显示侧边栏",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "workspaceMap.openLocation",
        "title": "Workspace Map: 打开位置",
        "icon": "$(folder-opened)"
      },
      {
        "command": "workspaceMap.back",
        "title": "Workspace Map: 返回",
        "icon": "$(arrow-left)"
      },
      {
        "command": "workspaceMap.forward",
        "title": "Workspace Map: 前进",
        "icon": "$(arrow-right)"
      },
      {
        "command": "workspaceMap.parent",
        "title": "Workspace Map: 上一级",
        "icon": "$(arrow-up)"
      },
      {
        "command": "workspaceMap.home",
        "title": "Workspace Map: 全部机器",
        "icon": "$(home)"
      },
      {
        "command": "workspaceMap.search",
        "title": "Workspace Map: 按名称找文件",
        "icon": "$(search)"
      },
      {
        "command": "workspaceMap.tasks",
        "title": "Workspace Map: 文件传输",
        "icon": "$(checklist)"
      },
      {
        "command": "workspaceMap.fit",
        "title": "Workspace Map: 定位已加载节点",
        "icon": "$(screen-full)"
      },
      {
        "command": "workspaceMap.resources",
        "title": "Workspace Map: 查看机器资源",
        "icon": "$(pulse)"
      },
      {
        "command": "workspaceMap.favoriteCurrent",
        "title": "Workspace Map: 收藏当前工作区",
        "icon": "$(bookmark)"
      },
      {
        "command": "workspaceMap.favoriteFile",
        "title": "Workspace Map: 收藏工作区文件",
        "icon": "$(file-code)"
      },
      {
        "command": "workspaceMap.favoriteDirectory",
        "title": "Workspace Map: 收藏项目目录",
        "icon": "$(bookmark)"
      },
      {
        "command": "workspaceMap.openWorkspace",
        "title": "Workspace Map: 打开常用工作区",
        "icon": "$(folder-opened)"
      },
      {
        "command": "workspaceMap.openWorkspaceNew",
        "title": "Workspace Map: 在新窗口打开工作区",
        "icon": "$(link-external)"
      },
      {
        "command": "workspaceMap.bindWorkspace",
        "title": "Workspace Map: 绑定原生 Remote 入口"
      },
      {
        "command": "workspaceMap.renameWorkspace",
        "title": "Workspace Map: 重命名工作区",
        "icon": "$(edit)"
      },
      {
        "command": "workspaceMap.removeWorkspace",
        "title": "Workspace Map: 移除工作区收藏",
        "icon": "$(close)"
      },
      {
        "command": "workspaceMap.workspaceUp",
        "title": "Workspace Map: 上移工作区",
        "icon": "$(arrow-up)"
      },
      {
        "command": "workspaceMap.workspaceDown",
        "title": "Workspace Map: 下移工作区",
        "icon": "$(arrow-down)"
      },
      {
        "command": "workspaceMap.locateWorkspace",
        "title": "Workspace Map: 在地图定位工作区",
        "icon": "$(map)"
      },
      {
        "command": "workspaceMap.addWorkspaceFolder",
        "title": "Workspace Map: 加入当前工作区",
        "icon": "$(new-folder)"
      },
      {
        "command": "workspaceMap.workspaceEnvironment",
        "title": "Workspace Map: 查看工作区环境",
        "icon": "$(tools)"
      },
      {
        "command": "workspaceMap.environment",
        "title": "Workspace Map: 查看项目环境",
        "icon": "$(tools)"
      },
      {
        "command": "workspaceMap.storage",
        "title": "Workspace Map: 查看存储占用",
        "icon": "$(database)"
      },
      {
        "command": "workspaceMap.importSSH",
        "title": "Workspace Map: 导入已有 SSH 配置",
        "icon": "$(remote)"
      },
      {
        "command": "workspaceMap.favorites",
        "title": "Workspace Map: 收藏",
        "icon": "$(bookmark)"
      },
      {
        "command": "workspaceMap.addFavorite",
        "title": "Workspace Map: 添加收藏",
        "icon": "$(add)"
      },
      {
        "command": "workspaceMap.renameMachine",
        "title": "Workspace Map: 重命名机器",
        "icon": "$(edit)"
      },
      {
        "command": "workspaceMap.workloads",
        "title": "Workspace Map: 作业",
        "icon": "$(list-tree)"
      }
    ],
    "configuration": {
      "title": "Workspace Map",
      "properties": {
        "workspaceMap.endpoints": {
          "type": "array",
          "default": [],
          "description": "Generic SSH endpoints: id, name, host (OpenSSH alias), sshConfig, distro (Windows WSL transport), root, python."
        },
        "workspaceMap.pageSize": {
          "type": "number",
          "default": 200,
          "minimum": 20,
          "maximum": 1000
        },
        "workspaceMap.transferConcurrency": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 8
        },
        "workspaceMap.monitorPython": {
          "type": "string",
          "default": "",
          "description": "Local resource collector Python executable (standard library only). Empty uses python on Windows or python3 on Linux."
        },
        "workspaceMap.resourceRecordingDirectory": {
          "type": "string",
          "default": "",
          "description": "Absolute native path for bounded resource recordings. Empty uses this map globalStorage. Recordings stop at 10 minutes or 20 MiB."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workspaceMap",
          "title": "Workspace Map",
          "icon": "media/map.svg"
        }
      ]
    },
    "views": {
      "workspaceMap": [
        {
          "id": "workspaceMap.locations",
          "name": "目录地图",
          "icon": "media/map.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "workspaceMap.addEndpoint",
          "when": "view == workspaceMap.locations",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "workspaceMap.openWorkspaceNew",
          "when": "view == workspaceMap.locations && viewItem == workspaceMap.favorite",
          "group": "workspace@0"
        },
        {
          "command": "workspaceMap.addWorkspaceFolder",
          "when": "view == workspaceMap.locations && viewItem == workspaceMap.favorite",
          "group": "workspace@1"
        },
        {
          "command": "workspaceMap.locateWorkspace",
          "when": "view == workspaceMap.locations && viewItem == workspaceMap.favorite",
          "group": "workspace@2"
        },
        {
          "command": "workspaceMap.workspaceEnvironment",
          "when": "view == workspaceMap.locations && viewItem == workspaceMap.favorite",
          "group": "inline@1"
        },
        {
          "command": "workspaceMap.bindWorkspace",
          "when": "view == workspaceMap.locations && viewItem == workspaceMap.favorite",
          "group": "workspace@4"
        },
        {
          "command": "workspaceMap.renameWorkspace",
          "when": "view == workspaceMap.locations && viewItem == workspaceMap.favorite",
          "group": "workspace@5"
        },
        {
          "command": "workspaceMap.workspaceUp",
          "when": "view == workspaceMap.locations && viewItem == workspaceMap.favorite",
          "group": "workspace@6"
        },
        {
          "command": "workspaceMap.workspaceDown",
          "when": "view == workspaceMap.locations && viewItem == workspaceMap.favorite",
          "group": "workspace@7"
        },
        {
          "command": "workspaceMap.removeWorkspace",
          "when": "view == workspaceMap.locations && viewItem == workspaceMap.favorite",
          "group": "workspace@8"
        },
        {
          "command": "workspaceMap.addFavorite",
          "when": "view == workspaceMap.locations && viewItem == workspaceMap.favoritesGroup",
          "group": "inline"
        }
      ],
      "explorer/context": [
        {
          "command": "workspaceMap.favoriteDirectory",
          "when": "explorerResourceIsFolder",
          "group": "workspaceMap"
        }
      ]
    },
    "keybindings": [
      {
        "command": "workspaceMap.open",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      },
      {
        "command": "workspaceMap.sidebar",
        "key": "ctrl+alt+shift+m",
        "mac": "cmd+alt+shift+m"
      },
      {
        "command": "workspaceMap.back",
        "key": "alt+left",
        "when": "activeWebviewPanelId == workspaceMap && !inputFocus && !workspaceMap.textInputFocus"
      },
      {
        "command": "workspaceMap.forward",
        "key": "alt+right",
        "when": "activeWebviewPanelId == workspaceMap && !inputFocus && !workspaceMap.textInputFocus"
      },
      {
        "command": "workspaceMap.parent",
        "key": "alt+up",
        "when": "activeWebviewPanelId == workspaceMap && !inputFocus && !workspaceMap.textInputFocus"
      },
      {
        "command": "workspaceMap.search",
        "key": "ctrl+f",
        "when": "activeWebviewPanelId == workspaceMap && !inputFocus && !workspaceMap.textInputFocus",
        "mac": "cmd+f"
      },
      {
        "command": "workspaceMap.tasks",
        "key": "ctrl+shift+j",
        "when": "activeWebviewPanelId == workspaceMap && !inputFocus && !workspaceMap.textInputFocus",
        "mac": "cmd+shift+j"
      },
      {
        "command": "workspaceMap.fit",
        "key": "ctrl+0",
        "when": "activeWebviewPanelId == workspaceMap && !inputFocus && !workspaceMap.textInputFocus",
        "mac": "cmd+0"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "bench": "tsx scripts/benchmark.ts",
    "bench:lifecycle": "tsx scripts/benchmark-lifecycle.ts",
    "package": "vsce package --no-dependencies --allow-missing-repository --out artifacts/workspace-map.vsix && node scripts/release-assets.mjs",
    "vscode:prepublish": "npm run build",
    "test:portable": "tsx --test tests/portable.test.ts tests/monitor.test.ts tests/environments.test.ts tests/storage.test.ts tests/storage-protocol.test.ts tests/pressure.test.ts tests/maintenance.test.ts tests/fleet-performance.test.ts tests/operations.test.ts tests/agent-records.test.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.0",
    "cross-spawn": "^7.0.6",
    "d3-hierarchy": "^3.1.2",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/vscode": "^1.95.0",
    "@vscode/codicons": "^0.0.38",
    "@vscode/vsce": "^3.7.0",
    "esbuild": "^0.27.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/jiale-li-orion/Wayfarer.git"
  },
  "homepage": "https://github.com/jiale-li-orion/Wayfarer#readme",
  "bugs": {
    "url": "https://github.com/jiale-li-orion/Wayfarer/issues"
  }
}
